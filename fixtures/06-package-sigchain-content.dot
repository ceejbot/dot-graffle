// 06 — Package sigchain + content integrity  (explodes layer B of diagram 04).
// Two separate questions, two structures: the sigchain answers "who is
// authorized?" (authority); the file-tree Merkle answers "is this content
// authentic?" (integrity). A Publish link binds them by committing content_root
// + manifest_hash. Sources: sigchain.md, signing.md (canonical order §, file
// tree Merkle §, action discriminants §), archive-format.md, format-versioning.
digraph package_sigchain_content {
    rankdir=LR;
    labelloc="t";
    fontname="Helvetica";
    fontsize=20;
    label="Boltzmann — package sigchain (authority) + content Merkle (integrity)\nred = signs · blue = hash-link / commit";
    bgcolor="white";
    nodesep=0.4;
    ranksep=0.8;
    node [fontname="Helvetica", fontsize=10, style="filled"];
    edge [fontname="Helvetica", fontsize=9, penwidth=1.3];

    // ---- The package sigchain ----------------------------------------------
    subgraph cluster_chain {
        label="PACKAGE SIGCHAIN   (one per package, e.g. alice@foo.dev/pkg)";
        style="rounded,filled"; fillcolor="#fefce8"; color="#ca8a04";
        create  [label="seqno 1 · Create  (0x00)\nprev = ∅ · binds name → creator", shape=folder, fillcolor="#fde68a"];
        publish [label="seqno 2 · Publish  (0x03)\nversion · content_root[32]\nmanifest_hash[32] · attestation", shape=folder, fillcolor="#fef08a"];
        yank    [label="seqno 3 · Yank  (0x04)\nversion  (resolver-visible;\nexisting lockfiles still resolve)", shape=folder, fillcolor="#fef3c7"];
        create -> publish [color="#1d4ed8", label="prev = blake3(prev link)"];
        publish -> yank   [color="#1d4ed8", label="prev"];
    }

    // ---- Canonical serialization order (what gets hashed & signed) ----------
    canon [label="CANONICAL LINK BYTES  (field order)\l 1 algorithm (u8 = 0x00 Ed25519)\l 2 seqno (u64 LE)\l 3 prev (Option<32B>)\l 4 package (string)\l 5 action (1-byte discriminant + fields)\l 6 actor.user_id (16B, length-prefixed*)\l 7 actor.label (string)\l 8 timestamp_ms (u64 LE)\l 9 effective_ms (u64 LE)\l10 webauthn_attestation (Option<bytes>)\l   * historical exception; new fixed fields are raw\lexcludes host_signature (that is being computed)\l", shape=note, fillcolor="#f1f5f9", fontsize=9];
    linkhash [label="link_hash =\nblake3(canonical bytes)", shape=octagon, fillcolor="#bbf7d0"];
    publish -> canon [style=dotted, color="#64748b", label="serialize"];
    canon -> linkhash [color="#1d4ed8"];

    // ---- Dual signing -------------------------------------------------------
    hostkey [label="host Ed25519 key\n(active key from host sigchain — see 05)", shape=house, fillcolor="#fdba74"];
    passkey [label="publisher passkey\n(WebAuthn authenticator)", shape=house, fillcolor="#fdba74"];
    challenge [label="challenge =\nblake3(canonical link data)", shape=octagon, fillcolor="#fed7aa"];

    hostkey -> create  [color="#dc2626", label="signs"];
    hostkey -> publish [color="#dc2626", label="signs (over full bytes,\nincl. the assertion)"];
    hostkey -> yank    [color="#dc2626"];
    publish -> challenge [style=dotted, color="#64748b", label="link data"];
    challenge -> passkey [color="#dc2626"];
    passkey -> publish [color="#dc2626", style=dashed, label="assertion embedded\n→ field 10, covered by host sig"];

    // ---- Content side: the file-tree Merkle ---------------------------------
    subgraph cluster_content {
        label="CONTENT INTEGRITY   (.ent archive: magic · manifest JSON · zstd file stream)";
        style="rounded,filled"; fillcolor="#f0fdf4"; color="#22c55e";

        f0 [label="README.md", shape=box, fillcolor="#dcfce7"];
        f1 [label="src/lib.rs", shape=box, fillcolor="#dcfce7"];
        f2 [label="src/util.rs", shape=box, fillcolor="#dcfce7"];

        leaf0 [label="leaf0", shape=octagon, fillcolor="#bbf7d0"];
        leaf1 [label="leaf1", shape=octagon, fillcolor="#bbf7d0"];
        leaf2 [label="leaf2\n(promoted, odd)", shape=octagon, fillcolor="#bbf7d0"];

        leafform [label="leaf = blake3(0x00 ‖ path ‖ 0x00\n   ‖ content_hash ‖ 0x00 ‖ size_le)\nfiles sorted by path first", shape=note, fillcolor="#ecfdf5", fontsize=9];

        node01 [label="node01 =\nblake3(0x01 ‖ leaf0 ‖ leaf1)", shape=octagon, fillcolor="#86efac"];
        croot  [label="content_root =\nblake3(0x01 ‖ node01 ‖ leaf2)\n(0x00/0x01 prefixes block\nsecond-preimage attacks)", shape=octagon, fillcolor="#4ade80", penwidth=2];

        f0 -> leaf0; f1 -> leaf1; f2 -> leaf2;
        leaf0 -> node01 [color="#1d4ed8"]; leaf1 -> node01 [color="#1d4ed8"];
        node01 -> croot [color="#1d4ed8"]; leaf2 -> croot [color="#1d4ed8"];
        leafform -> leaf0 [style=invis];
    }
    mhash [label="manifest_hash =\nblake3(manifest bytes)", shape=octagon, fillcolor="#86efac"];

    // ---- The Publish link commits content_root + manifest_hash --------------
    croot -> publish [color="#1d4ed8", label="committed in Publish"];
    mhash -> publish [color="#1d4ed8"];

    // ---- Key insight note ---------------------------------------------------
    insight [label="content_root is host-INDEPENDENT (no name/namespace/host inside).\nA hash alone does not prove provenance — verifiers MUST check the\nPublish link, which binds this content to this package + actor.", shape=note, fillcolor="#fff7ed", fontsize=9];
    { rank=sink; insight; }
}
