// 08 — Witness regime + keystone  (explodes layer D of diagram 04).
// Witnesses are the actual root of trust for HISTORICAL claims: independent
// parties, with independent keys/algorithms, that cosign the home host's log
// heads. The keystone root manifest tells a consumer WHICH witnesses to trust
// and is itself M-of-N quorum-signed (self-authenticating, TUF-style).
// Sources: witness-regime.md; W-C mirror-serving spec (2026-06-10); W-D daemon
// /gossip spec (2026-06-12); W-E keystone spec (2026-06-13) §4–§5; W-E
// consumer-protocol spec (2026-06-14); transparency protocol spec §5.
digraph witness_regime_keystone {
    rankdir=TB;
    labelloc="t";
    fontname="Helvetica";
    fontsize=20;
    label="Boltzmann — witness regime + keystone (M-of-N root manifest)\nred = signs · purple = cosigns · green = consumer verify/pin";
    bgcolor="white";
    nodesep=0.45;
    ranksep=0.7;
    node [fontname="Helvetica", fontsize=10, style="filled"];
    edge [fontname="Helvetica", fontsize=9, penwidth=1.3];

    // ---- Input from 07 ------------------------------------------------------
    ckpt [label="SignedLogCheckpoint  (from 07)\nlog_size · log_root", shape=note, fillcolor="#fef08a"];

    // ---- Witness identity + key-record chain + cosignature ------------------
    subgraph cluster_identity {
        label="witness identity   (one per witness; independent of the host)";
        style="rounded,filled"; fillcolor="#faf5ff"; color="#a855f7";
        wid [label="witness_identity_hash =\nblake3(\"…/witness/identity/v1\" ‖ identity_payload)\nIMMUTABLE — stable across key rotations", shape=octagon, fillcolor="#ddd6fe"];
        kr1 [label="WitnessKeyRecord (key K_w0)\naccepts_at · retires_at", shape=folder, fillcolor="#ede9fe"];
        kr2 [label="WitnessKeyRecord (rotate → K_w1)\nprevious_key_record_hash (chained)\ndual-signed: old key + new key", shape=folder, fillcolor="#ede9fe"];
        wid -> kr1 [color="#1d4ed8"]; kr1 -> kr2 [color="#1d4ed8", label="chain"];
    }
    wkey [label="active witness key\n(independent algorithm; may go\npost-quantum before the host)", shape=house, fillcolor="#fdba74"];
    kr2 -> wkey [style=dotted, color="#64748b"];

    cosig [label="WitnessCosignature\ndigest = blake3(\"…/witness/statement/v1\"\n  ‖ witness_identity_hash ‖ log_size ‖ log_root)\nsignature over the DIGEST (replay-defense pattern)", shape=note, fillcolor="#ddd6fe"];
    wkey -> cosig [color="#dc2626", label="signs"];

    // ---- Witness daemon loop (W-D) -----------------------------------------
    subgraph cluster_daemon {
        label="witness daemon loop   (boltzmann-witness, W-D)";
        style="rounded,filled"; fillcolor="#eef2ff"; color="#6366f1";
        observe [label="observe checkpoint", fillcolor="#c7d2fe"];
        verify  [label="verify: host sig · inclusion ·\nconsistency · MMD freshness", fillcolor="#c7d2fe"];
        decide  [label="cosign  ⊕  adopt anchor\n(refuse on equivocation\nat the same log_size)", shape=diamond, fillcolor="#c7d2fe"];
        persist [label="persist divergence memory", fillcolor="#c7d2fe"];
        serve   [label="serve /witness/v1/\nview · equivocations · identity", fillcolor="#c7d2fe"];
        observe -> verify -> decide -> persist -> serve;
        serve -> observe [color="#4338ca", label="loop", constraint=false];
    }
    ckpt -> observe [color="#7c3aed"];
    decide -> cosig [color="#7c3aed", style=dashed, label="if conforming"];
    gossip [label="gossip with peer witnesses\n→ merged equivocation feed", shape=note, fillcolor="#eef2ff", fontsize=9];
    serve -> gossip [dir=both, color="#7c3aed"];

    // ---- Mirror contract note (W-C) ----------------------------------------
    mirror [label="mirror contract (W-C): a mirror serves the CURRENT root +\ncheckpoint + proofs + cosignatures (M1–M7). Relayed by an\nUNTRUSTED mirror, the checkpoint is self-authenticating to a\nconsumer holding pinned witness identities.", shape=note, fillcolor="#f1f5f9", fontsize=9];

    // ---- The keystone root manifest (W-E) ----------------------------------
    subgraph cluster_keystone {
        label="KEYSTONE: witness root manifest + M-of-N envelope   (W-E)";
        style="rounded,filled"; fillcolor="#fff7ed"; color="#fb923c";

        members [label="witness members[N_w]  (the SUBJECT — consumer M-of-N)\nwitness_identity_hash · lifecycle_state\n(Usable 0x00 / ReadOnly 0x01 / Retired 0x02 / Compromised 0x03)\naccepted_key_records[K] · witness_threshold_m", shape=note, fillcolor="#fed7aa"];
        quorum  [label="governance quorum_keys[N_q]  (who signs the NEXT manifest)\nquorum_threshold · genesis floor ≥ 2-of-3", shape=note, fillcolor="#fdba74"];
        manifest[label="RootManifestPayload  (structure_tag 0x22 @ offset 0)\nsurface_version · manifest_version (monotonic)\nprevious_manifest_hash · topology_edges · flags · timestamp", shape=note, fillcolor="#fde68a"];
        mhash   [label="root_manifest_hash =\nblake3(\"boltzmann/root-manifest/v1\" ‖ payload_bytes)", shape=octagon, fillcolor="#fcd34d"];
        envelope[label="RootManifestEnvelope =\npayload ‖ signature_count ‖ signatures[S]\n{signer_key (self-describing) · sig_wire}\nsorted by (algorithm, key); strictly increasing = dedup", shape=note, fillcolor="#fef08a"];
        qkeys   [label="quorum signers\n(M-of-N, algorithm-diverse)", shape=house, fillcolor="#fb923c"];

        members -> manifest [color="#1d4ed8"]; quorum -> manifest [color="#1d4ed8"];
        manifest -> mhash [color="#1d4ed8"];
        mhash -> envelope [color="#1d4ed8"];
        qkeys -> envelope [color="#dc2626", label="each signs root_manifest_hash"];

        twokeys [label="TWO DISTINCT KEY-SETS, never conflated:\ngovernance quorum signs manifests;\nwitness members are pinned for consumer M-of-N.\nA witness key never signs a manifest.", shape=note, fillcolor="#fff1f2", fontsize=9];
        twokeys -> members [style=invis];
    }

    // ---- Consumer -----------------------------------------------------------
    consumer [label="CONSUMER\n• pins the keystone (genesis = trust-on-first-use, shipped in binary)\n• runs M-of-N over the members' cosignatures of the host checkpoint\n• TUF update V→V+1: envelope verifies vs PRIOR quorum;\n  previous_manifest_hash == current; manifest-log consistency;\n  two-level anti-rollback; sticky revocation of compromised ids", shape=box, style="rounded,filled", fillcolor="#bbf7d0", penwidth=2];

    members  -> consumer [color="#059669", label="the set to run M-of-N over"];
    cosig    -> consumer [color="#059669", label="verify ≥ M distinct cosigs"];
    envelope -> consumer [color="#059669", style=dashed, label="self-authenticating"];
    mirror   -> consumer [style=invis];
}
