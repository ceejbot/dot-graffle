// 05 — Host identity & sigchain  (explodes layer A of diagram 04).
// The root of trust. A host's identity is two permanent things established at
// genesis: its DNS name and its host_root. The host sigchain is an append-only,
// hash-linked log of identity events; walking it yields the signing key active
// at any timestamp. Sources: sigchain.md § host sigchain, signing.md (canonical
// order), 2026-04-26 host-action canonical spec, 2026-05-16 TXT-binding spec.
digraph host_identity_sigchain {
    rankdir=LR;
    labelloc="t";
    fontname="Helvetica";
    fontsize=20;
    label="Boltzmann — host identity & sigchain  (root of trust)\nred = signs · blue = hash-link (prev) · green = verify";
    bgcolor="white";
    nodesep=0.45;
    ranksep=0.85;
    node [fontname="Helvetica", fontsize=10, style="filled"];
    edge [fontname="Helvetica", fontsize=9, penwidth=1.3];

    // ---- The host sigchain (genesis → … hash-linked) ------------------------
    subgraph cluster_chain {
        label="HOST SIGCHAIN   (append-only, hash-linked; one per host installation)";
        style="rounded,filled"; fillcolor="#fffbeb"; color="#f59e0b";

        l1 [label="seqno 1 · InitHost  (genesis)\ninitial_key K0 · dns_name · operator\nprev = ∅ · host_root field OMITTED\nfrom canonical bytes\nsigned by: K0", shape=folder, fillcolor="#fde68a"];
        l2 [label="seqno 2 · AttestPredecessor  (optional)\npredecessor_host_root · predecessor_tip\nsigned by: predecessor final key + K0", shape=folder, fillcolor="#fef3c7"];
        l3 [label="RotateKey\nold_key_fp · new_key K1\neffective_ms = now + 48 h (cooling-off)\nsigned by: K0 AND K1", shape=folder, fillcolor="#fef3c7"];
        l4 [label="CancelRotation  (defensive, immediate)\npending_link_hash → the RotateKey\nsigned by: currently-active key (K0)", shape=folder, fillcolor="#fee2e2"];
        l5 [label="Retire  (terminal)\nsuccessor_host_root? · effective_ms +48 h\nsigned by: active key", shape=folder, fillcolor="#fef3c7"];

        l1 -> l2 [color="#1d4ed8", label="prev = blake3(prev link)"];
        l2 -> l3 [color="#1d4ed8", label="prev"];
        l3 -> l5 [color="#1d4ed8", label="prev"];
        // CancelRotation is an alternate branch that refutes a pending rotation
        l3 -> l4 [color="#dc2626", style=dashed, dir=back, label="refutes pending rotation\n(within 48 h window)"];
    }

    // ---- Keys ---------------------------------------------------------------
    k0 [label="K0  initial key", shape=house, fillcolor="#fdba74"];
    k1 [label="K1  rotated key\n(active only after effective_ms)", shape=house, fillcolor="#fdba74"];
    k0 -> l1 [color="#dc2626", label="signs"];
    k0 -> l3 [color="#dc2626", style=dashed];
    k1 -> l3 [color="#dc2626", style=dashed, label="dual-signed"];

    // ---- host_root derivation ----------------------------------------------
    hroot [label="host_root = blake3(canonical(InitHost))\nthe permanent cryptographic anchor\nstable across rotations & operator changes", shape=octagon, fillcolor="#bbf7d0"];
    l1 -> hroot [color="#1d4ed8", label="hash of genesis"];

    // ---- Key timeline (derived) --------------------------------------------
    timeline [label="KEY TIMELINE  (derived by walking the chain)\nstart at K0 → apply each EFFECTIVE RotateKey\n→ skip any CancelRotation'd rotation\n→ stop at any EFFECTIVE Retire\n⇒ active key at timestamp t", shape=box, style="rounded,filled", fillcolor="#dbeafe"];
    l1 -> timeline [style=dotted, color="#64748b"];
    l3 -> timeline [style=dotted, color="#64748b"];
    l5 -> timeline [style=dotted, color="#64748b"];

    // ---- DNS TXT binding ----------------------------------------------------
    txt [label="DNS TXT  _boltzmann.<dns_name>\n\"v=1; root=<host_root>; sig=<Ed25519>;\n iat=<unix>; exp=<unix>\"\nsigned by the host key active at iat", shape=note, fillcolor="#fcd34d"];
    hroot -> txt [color="#1d4ed8", label="root = host_root"];
    k0 -> txt [color="#dc2626", style=dashed, label="signs over (v,dns_name,root,iat,exp)"];

    // ---- Consumer verification ---------------------------------------------
    verify [label="CONSUMER VERIFICATION\n1. resolve TXT; reject if malformed/expired\n2. genesis link must hash to TXT root\n3. key active @ iat verifies the TXT sig\n4. reject if an effective Retire exists\n5. if a host_root is pinned, it must match\n   (no silent pin migration)", shape=box, style="rounded,filled", fillcolor="#bbf7d0", penwidth=2];
    txt -> verify [color="#059669"];
    timeline -> verify [color="#059669", style=dashed];
    hroot -> verify [color="#059669", style=dashed];

    // ---- Note: no WebAuthn at host level ------------------------------------
    note [label="Host actions are NOT dual-signed with a passkey —\nthey are taken by whoever holds the host key.\nWebAuthn is a property of PACKAGE actions (see 06).", shape=note, fillcolor="#f1f5f9", fontsize=9];
    { rank=sink; note; }
}
